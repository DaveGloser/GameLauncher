<Window
    AllowsTransparency="True"
    Background="Transparent"
    Height="304"
    ResizeMode="NoResize"
    Title="Launcher Update"
    Width="540"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    x:Class="GameLauncher.CheckForUpdater"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <ImageBrush
            ImageSource="../Assets/Images/Backgrounds/Frame_1280x720.png"
            Stretch="Fill"
            x:Key="WindowFrame" />
        <ImageBrush
            ImageSource="../Assets/Images/Backgrounds/Background_Small.png"
            Stretch="Fill"
            x:Key="WindowBackGroundBrush" />
        <Style TargetType="Button" x:Key="WindowButtonStyle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#55FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackGroundBrush}">
        <Grid Background="{StaticResource WindowFrame}">
            <Grid
                Background="Transparent"
                Height="50"
                MouseLeftButtonDown="TitleBar"
                VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Click="Close"
                    Grid.Column="1"
                    Height="40"
                    Margin="5"
                    Style="{StaticResource WindowButtonStyle}"
                    Width="40">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image
                                    Name="ButtonImage"
                                    Source="../Assets/Images/Buttons/Close.png"
                                    Stretch="Fill" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Source" TargetName="ButtonImage" Value="../Assets/Images/Buttons/Close_Hover.png" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    Text="Launcher update is available."
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="#B59996"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>
                <Button
                    BorderThickness="0"
                    Click="UpdateButton_Click"
                    Content="Update"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#EAD796"
                    Height="80"
                    Name="updateButton"
                    HorizontalAlignment="Center"
                    Margin="30"
                    VerticalAlignment="Center"
                    Width="225">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image
                                    Name="ButtonImage"
                                    Source="../Assets/Images/Buttons/Button.png"
                                    Stretch="Fill" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Source" TargetName="ButtonImage" Value="../Assets/Images/Buttons/Button_Hover.png" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <ProgressBar
                    Height="30"
                    HorizontalAlignment="Center"
                    Maximum="100"
                    Minimum="0"
                    BorderThickness="0"
                    Value="0"
                    VerticalAlignment="Top"
                    Visibility="Collapsed"
                    Width="400"
                    Name="progressBar">
                    <ProgressBar.Background>
                        <ImageBrush ImageSource="../Assets/Images/EmptyBar.png" Stretch="Fill" />
                    </ProgressBar.Background>
                    <ProgressBar.Foreground>
                        <ImageBrush ImageSource="../Assets/Images/FillBar.png" Stretch="Fill" />
                    </ProgressBar.Foreground>
                </ProgressBar>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
