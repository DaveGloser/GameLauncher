<Window
    AllowsTransparency="True"
    Background="Transparent"
    Height="405"
    ResizeMode="NoResize"
    Title="Installation"
    Width="720"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    x:Class="GameLauncher.InstallPathWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <ImageBrush
            ImageSource="../Assets/Images/Backgrounds/Frame_1280x720.png"
            Stretch="Fill"
            x:Key="WindowFrame" />
        <ImageBrush
            ImageSource="../Assets/Images/Backgrounds/Background_Small.png"
            Stretch="Fill"
            x:Key="WindowBackGroundBrush" />
        <Style TargetType="Button" x:Key="WindowButtonStyle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#55FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackGroundBrush}">
        <Grid Background="{StaticResource WindowFrame}">
            <Grid
                Background="Transparent"
                Height="50"
                MouseLeftButtonDown="TitleBar"
                VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Click="Close"
                    Grid.Column="1"
                    Height="40"
                    Margin="5"
                    Style="{StaticResource WindowButtonStyle}"
                    Width="40"
                    x:Name="CloseButton">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image
                                    Name="ButtonImage"
                                    Source="../Assets/Images/Buttons/Close.png"
                                    Stretch="Fill" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Source" TargetName="ButtonImage" Value="../Assets/Images/Buttons/Close_Hover.png" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
<StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="#B59996"
                        Margin="10,0,0,0"
                        Text="Choose Installation Directory"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center" />
                    <StackPanel
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,10"
                        Orientation="Horizontal">
                        <TextBox
                            BorderThickness="0"
                            Foreground="#B59996"
                            Height="30"
                            HorizontalContentAlignment="Center"
                            IsReadOnly="True"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Width="350"
                            x:Name="InstallPathTextBox">
                            <TextBox.Background>
                                <ImageBrush ImageSource="../Assets/Images/EmptyBar.png" />
                            </TextBox.Background>
                        </TextBox>

                        <Button
                            BorderThickness="0"
                            Click="BrowseButton_Click"
                            Content="Browse"
                            FontWeight="Bold"
                            Foreground="#B59996"
                            Height="35"
                            Margin="5,0,0,0"
                            Width="80">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Image
                                            Name="ButtonImage"
                                            Source="../Assets/Images/Buttons/Button.png"
                                            Stretch="Fill" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Source" TargetName="ButtonImage" Value="../Assets/Images/Buttons/Button_Hover.png" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="450">
                        <TextBox
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="15"
                            Margin="0,10"
                            Foreground="#B59996"
                            HorizontalAlignment="Center"
                            IsReadOnly="True"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Text="Select a folder where you want to install the game. This will install the full game client, or if you select an existing game client, it will only install the game files.&#xA;&#xA;You need at least 50GB of free space.">
                        </TextBox>
                    </StackPanel>
                    <StackPanel
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <Button
                            BorderThickness="0"
                            Click="InstallButton_Click"
                            Content="Install"
                            FontSize="40"
                            FontWeight="Bold"
                            Foreground="#EAD796"
                            Height="80"
                            HorizontalAlignment="Center"
                            Margin="10"
                            VerticalAlignment="Center"
                            Width="260">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Image
                                            Name="ButtonImage"
                                            Source="../Assets/Images/Buttons/Button.png"
                                            Stretch="Fill" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Source" TargetName="ButtonImage" Value="../Assets/Images/Buttons/Button_Hover.png" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
</Window>